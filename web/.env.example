# MarketLens Web Frontend Environment Configuration
# Copy this file to `web/.env` or `web/.env.local` to enable local overrides.

# Free Groq Cloud API Key (Recommended for ultra-fast Llama 3.3 70B inference)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Free Google Gemini API Key (Gemini 1.5 Flash)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# xAI Grok API Key (Grok-2)
# Get your key at: https://x.ai/api
VITE_GROK_API_KEY=

# Optional Backend API URL (leave empty for same-origin proxy)
VITE_API_URL=
