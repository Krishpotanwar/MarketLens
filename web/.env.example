# MarketLens Web Frontend Environment Configuration
# Copy this file to `web/.env` or `web/.env.local` to enable local overrides.

# Optional Backend API URL (leave empty for the same-origin dev proxy)
VITE_API_URL=

# AI provider keys are deliberately not read from environment variables: Vite compiles every
# VITE_* value into the public bundle. Paste a key into the AI Strategy Lab in the browser instead.
