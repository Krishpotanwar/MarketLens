# MarketLens Environment Configuration

# ==============================================================================
# 1. AI Reasoning Engine & Quantitative Strategy Lab (Frontend / Web)
# ==============================================================================
# Choose any of the following providers for the AI Strategy Lab.
# Note: If no API key is configured, MarketLens automatically runs using our
# built-in deterministic Offline Heuristic Reasoning Engine (no key needed).
#
# Free Groq Cloud API Key (Recommended for ultra-fast Llama 3.3 70B inference)
# Get a free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Free Google Gemini API Key (Gemini 1.5 Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API Key (Grok-2)
# Get a key at: https://x.ai/api
VITE_GROK_API_KEY=your_grok_api_key_here

# Optional Backend API URL (Leave blank for default same-origin / local proxy)
VITE_API_URL=

# ==============================================================================
# 2. Institutional Broker Feeds (Backend - Optional)
# ==============================================================================
# If left blank, MarketLens automatically falls back to direct live NSE telemetry
# which streams quotes and market breadth directly with zero authentication required.

# Angel One SmartAPI (https://smartapi.angelbroking.com)
SMARTAPI_API_KEY=your_smartapi_key_here
SMARTAPI_CLIENT_CODE=your_client_code_optional
SMARTAPI_PIN=your_mpin_optional

# Dhan HQ API (https://dhanhq.co)
DHAN_CLIENT_ID=your_dhan_client_id_optional
DHAN_ACCESS_TOKEN=your_dhan_token_optional
