# MarketLens Environment Configuration

# Angel One SmartAPI Credentials
# If left blank, MarketLens automatically falls back to our direct live NSE telemetry
SMARTAPI_API_KEY=your_smartapi_key_here
SMARTAPI_CLIENT_CODE=your_client_code_optional
SMARTAPI_PIN=your_mpin_optional

# Dhan HQ API (Alternative)
DHAN_CLIENT_ID=your_dhan_client_id_optional
DHAN_ACCESS_TOKEN=your_dhan_token_optional
